package aegilex:endstone@0.1.0;

// Endstone header: endstone/event/player/player_chat_event.h
interface player-chat-event {
    use player.{player};
    use types.{host-error};

    resource player-chat-event {
        get-player: func() -> result<player, host-error>;
        set-player: func(player: borrow<player>) -> result<_, host-error>;
        get-message: func() -> result<string, host-error>;
        set-message: func(message: string) -> result<_, host-error>;
        get-format: func() -> result<string, host-error>;
        set-format: func(format: string) -> result<_, host-error>;
        get-recipients: func() -> result<list<player>, host-error>;
        is-cancelled: func() -> result<bool, host-error>;
        set-cancelled: func(cancelled: bool) -> result<_, host-error>;
    }
}
