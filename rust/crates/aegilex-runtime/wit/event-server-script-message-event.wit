package aegilex:endstone@0.1.0;

// Endstone header: endstone/event/server/script_message_event.h
interface script-message-event {
    use command-sender.{command-sender};
    use types.{host-error};

    resource script-message-event {
        get-message-id: func() -> result<string, host-error>;
        get-message: func() -> result<string, host-error>;
        get-sender: func() -> result<command-sender, host-error>;
        is-cancelled: func() -> result<bool, host-error>;
        set-cancelled: func(cancelled: bool) -> result<_, host-error>;
    }
}
