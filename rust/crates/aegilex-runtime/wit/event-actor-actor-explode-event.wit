package aegilex:endstone@0.1.0;

// Endstone header: endstone/event/actor/actor_explode_event.h
interface actor-explode-event {
    use actor.{actor};
    use location.{location};
    use types.{host-error};

    use block.{block};
    resource actor-explode-event {
        get-actor: func() -> result<actor, host-error>;
        get-location: func() -> result<location, host-error>;
        get-block-list: func() -> result<list<block>, host-error>;
        is-cancelled: func() -> result<bool, host-error>;
        set-cancelled: func(cancelled: bool) -> result<_, host-error>;
    }

}
