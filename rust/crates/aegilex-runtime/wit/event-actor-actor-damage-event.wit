package aegilex:endstone@0.1.0;

// Endstone header: endstone/event/actor/actor_damage_event.h
interface actor-damage-event {
    use actor.{actor};
    use damage-source.{damage-source};
    use types.{host-error};

    resource actor-damage-event {
        get-actor: func() -> result<actor, host-error>;
        get-damage: func() -> result<f32, host-error>;
        set-damage: func(damage: f32) -> result<_, host-error>;
        get-damage-source: func() -> result<damage-source, host-error>;
        is-cancelled: func() -> result<bool, host-error>;
        set-cancelled: func(cancelled: bool) -> result<_, host-error>;
    }
}
